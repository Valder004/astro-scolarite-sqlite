---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Connexion">
	<section class="login-page" aria-labelledby="login-title">
		<div class="login-panel">
			<p class="login-kicker">Portail de scolarité</p>
			<h1 id="login-title">Connexion</h1>
			<p class="login-description">Connectez-vous avec votre compte Google pour accéder à l’application.</p>
			<form id="google-signin-form" action="/api/auth/signin/google" method="post">
				<input id="csrf-token" type="hidden" name="csrfToken" value="">
				<button type="submit" class="google-signin">
					<span class="google-mark" aria-hidden="true">G</span>
					<span>Se connecter avec Google</span>
				</button>
			</form>
			<p id="login-error" class="login-error" role="status" aria-live="polite"></p>

		</div>
	</section>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('#google-signin-form');
	const csrfInput = document.querySelector<HTMLInputElement>('#csrf-token');
	const errorMessage = document.querySelector<HTMLElement>('#login-error');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!csrfInput) return;

		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (button) button.disabled = true;

		try {
			const response = await fetch('/api/auth/csrf', { credentials: 'same-origin' });
			if (!response.ok) throw new Error('Impossible de récupérer le jeton CSRF.');

			const { csrfToken } = await response.json();
			if (!csrfToken) throw new Error('Le jeton CSRF est absent.');

			csrfInput.value = csrfToken;
			form.submit();
		} catch {
			if (errorMessage) {
				errorMessage.textContent = 'La connexion n’a pas pu démarrer. Réessayez.';
			}
			if (button) button.disabled = false;
		}
	});
</script>

<style>
	.login-page {
		min-height: calc(100vh - 100px);
		display: grid;
		place-items: center;
		padding: 32px 16px;
	}

	.login-panel {
		width: min(100%, 420px);
		padding: 36px;
		border: 1px solid #d9e0e8;
		border-top: 4px solid #2f765b;
		border-radius: 8px;
		background: #fff;
		box-shadow: 0 12px 32px #17203312;
	}

	.login-kicker {
		margin: 0 0 10px;
		color: #2f765b;
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: 1.8rem;
	}

	.login-description {
		margin: 12px 0 28px;
		color: #536174;
		line-height: 1.55;
	}

	.login-error {
		margin: 12px 0 0;
		color: #a52c2c;
		font-size: 0.9rem;
	}

	:global(.google-signin) {
		display: flex;
		width: 100%;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		gap: 12px;
		border: 1px solid #c9d1db;
		border-radius: 6px;
		background: #fff;
		color: #172033;
		cursor: pointer;
		font: inherit;
		font-weight: 650;
		transition: background-color 140ms ease, border-color 140ms ease;
	}

	:global(.google-signin:hover) {
		border-color: #8c9aab;
		background: #f5f7fa;
	}

	:global(.google-signin:disabled) {
		cursor: wait;
		opacity: 0.7;
	}

	:global(.google-signin:focus-visible) {
		outline: 3px solid #2f765b55;
		outline-offset: 3px;
	}

	.google-mark {
		color: #4285f4;
		font-size: 1.15rem;
		font-weight: 800;
	}

	@media (max-width: 480px) {
		.login-panel {
			padding: 28px 22px;
		}
	}
</style>
